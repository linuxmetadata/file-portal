/**
 * ======================================================
 * TXT EXTRACTOR
 * ======================================================
 *
 * Extract product records from TXT statements.
 *
 * Flow:
 *
 * TXT Reader
 *      â†“
 * TXT Header Detector
 *      â†“
 * TXT Header Mapper
 *      â†“
 * TXT Extractor
 *
 * One extractor for TXT files.
 *
 * The detected format determines how the mapped
 * positions are interpreted.
 *
 * ======================================================
 */


//======================================================
// NUMBER
//======================================================

function toNumber(value) {

    if (
        value === null ||
        value === undefined
    ) {

        return 0;

    }

    const text =
        String(value)
            .replace(/,/g, "")
            .trim();

    if (
        !text ||
        text === "-" ||
        text === "---"
    ) {

        return 0;

    }

    const number =
        Number(text);

    return Number.isFinite(number)
        ? number
        : 0;

}


//======================================================
// POSITION FROM MAPPING
//======================================================

function getMappedPosition(
    mapping,
    field
) {

    if (!mapping || !field) {
        return null;
    }

    const direct =
        mapping[field];

    if (
        direct &&
        typeof direct === "object" &&
        direct.position !== undefined
    ) {
        return Number(direct.position);
    }

    if (
        mapping.fields &&
        mapping.fields[field] &&
        mapping.fields[field].position !== undefined
    ) {
        return Number(
            mapping.fields[field].position
        );
    }

    if (
        mapping.positions &&
        mapping.positions[field] !== undefined
    ) {
        return Number(
            mapping.positions[field]
        );
    }

    return null;

}


//======================================================
// NUMERIC TOKENS
//======================================================

function getNumericTokens(line) {

    const tokens = [];
    const regex =
        /(^|\s)(-?\d+(?:,\d{3})*(?:\.\d+)?|---|-)(?=\s|$)/g;

    let match;

    while (
        (match = regex.exec(line))
    ) {

        const leading =
            match[1] || "";

        tokens.push({
            value:
                match[2],
            start:
                match.index + leading.length,
            end:
                match.index +
                match[0].length
        });

    }

    return tokens;

}


//======================================================
// PRODUCT / PACK FROM PREFIX
//======================================================

function splitProductAndPack(prefix) {

    const parts =
        String(prefix || "")
            .trim()
            .split(/\s{2,}/)
            .map(value => value.trim())
            .filter(Boolean);

    if (parts.length >= 2) {

        return {
            product:
                parts.slice(0, -1).join(" "),
            pack:
                parts[parts.length - 1]
        };

    }

    return {
        product:
            String(prefix || "").trim(),
        pack:
            ""
    };

}


//======================================================
// BASE RECORD
//======================================================

function createRecord(
    rowNumber,
    product,
    pack = "",
    productCode = null
) {

    return {

        rowNumber,

        product,

        productDescription:
            product,

        productCode,

        pack,

        opening:
            0,

        purchase:
            0,

        purchaseFree:
            0,

        purchaseReturn:
            0,

        purchaseValue:
            0,

        sales:
            0,

        salesReturn:
            0,

        free:
            0,

        replacement:
            0,

        branch:
            0,

        credit:
            0,

        debit:
            0,

        adjustment:
            0,

        salesValue:
            0,

        closing:
            0,

        closingValue:
            0,

        rate:
            0

    };

}


//======================================================
// PRODUCT WISE SALES
//======================================================

function extractProductWiseSales(
    lines,
    dataStart
) {

    const records = [];
    let current = null;

    function pushCurrent() {

        if (
            current &&
            (
                current.sales !== 0 ||
                current.salesValue !== 0
            )
        ) {
            records.push(current);
        }

    }

    for (
        let i = dataStart;
        i < lines.length;
        i++
    ) {

        const line =
            String(lines[i] || "");

        const text =
            line.trim();

        if (
            !text ||
            isSeparator(line) ||
            /^[-=\u00C4\s]+$/.test(text)
        ) {
            continue;
        }

        const isTransaction =
            /^\d{2}-\d{2}-\d{4}\s+|\s+[A-Z]{2,}\d{4,}\s+/.test(text);

        if (!isTransaction) {

            pushCurrent();

            current =
                createRecord(
                    i + 1,
                    text
                );

            continue;

        }

        if (!current) {
            continue;
        }

        const values =
            getNumericTokens(line)
                .map(
                    token =>
                        toNumber(token.value)
                );

        if (values.length < 3) {
            continue;
        }

        const qty =
            values[0] || 0;

        const amount =
            values.length >= 4
                ? values[values.length - 2]
                : values[values.length - 1];

        current.sales +=
            qty;

        current.salesValue +=
            amount || 0;

    }

    pushCurrent();

    return records;

}


//======================================================
// SPACED ROW FALLBACK
//======================================================

function extractSpacedRow(
    line,
    mapping,
    rowNumber
) {

    const numericTokens =
        getNumericTokens(line);

    if (
        numericTokens.length < 3
    ) {
        return null;
    }

    const firstNumeric =
        numericTokens[0];

    const prefix =
        line.substring(
            0,
            firstNumeric.start
        );

    const productPack =
        splitProductAndPack(prefix);

    if (
        !isValidProductRow(
            line,
            productPack.product,
            mapping
        )
    ) {
        return null;
    }

    /*
     * Common TXT format:
     *
     * Product Packing OP Receipt Qty Receipt Value
     * Sales Qty Sales Value Closing Qty Closing Value
     */

    const values =
        numericTokens.map(
            token =>
                toNumber(token.value)
        );

    const record = {

        rowNumber,

        product:
            productPack.product,

        productDescription:
            productPack.product,

        productCode:
            null,

        pack:
            productPack.pack,

        opening:
            0,

        purchase:
            0,

        purchaseFree:
            0,

        purchaseReturn:
            0,

        purchaseValue:
            0,

        sales:
            0,

        salesReturn:
            0,

        free:
            0,

        replacement:
            0,

        branch:
            0,

        credit:
            0,

        debit:
            0,

        adjustment:
            0,

        salesValue:
            0,

        closing:
            0,

        closingValue:
            0,

        rate:
            0,

        age:
            0

    };

    if (values.length >= 7) {

        record.opening =
            values[0];
        record.purchase =
            values[1];
        record.purchaseValue =
            values[2];
        record.sales =
            values[3];
        record.salesValue =
            values[4];
        record.closing =
            values[5];
        record.closingValue =
            values[6];

        return record;

    }

    if (values.length === 6) {

        record.opening =
            values[0];
        record.purchase =
            values[1];
        record.sales =
            values[2];
        record.salesReturn =
            values[3];
        record.adjustment =
            values[4];
        record.closing =
            values[5];

        return record;

    }

    return null;

}


//======================================================
// ITEM CODE ROW
//======================================================

function extractItemCodeRow(
    line,
    mapping,
    rowNumber
) {

    if (
        getMappedPosition(
            mapping,
            "productCode"
        ) === null
    ) {
        return null;
    }

    const numericTokens =
        getNumericTokens(line);

    if (
        numericTokens.length < 7 ||
        numericTokens[0].start > 2
    ) {
        return null;
    }

    const productCode =
        String(
            numericTokens[0].value
        ).trim();

    const valueTokens =
        numericTokens.slice(-6);

    const firstQuantity =
        valueTokens[0];

    const prefix =
        line.substring(
            numericTokens[0].end,
            firstQuantity.start
        );

    const productPack =
        splitProductAndPack(prefix);

    if (
        !productPack.product ||
        shouldStop(productPack.product)
    ) {
        return null;
    }

    const values =
        valueTokens
            .map(
                token =>
                    toNumber(token.value)
            );

    const record = {

        rowNumber,

        product:
            productPack.product,

        productDescription:
            productPack.product,

        productCode,

        pack:
            productPack.pack,

        opening:
            0,

        purchase:
            0,

        purchaseFree:
            0,

        purchaseReturn:
            0,

        purchaseValue:
            0,

        sales:
            0,

        salesReturn:
            0,

        free:
            0,

        replacement:
            0,

        branch:
            0,

        credit:
            0,

        debit:
            0,

        adjustment:
            0,

        salesValue:
            0,

        closing:
            0,

        closingValue:
            0,

        rate:
            0,

        lastMonth1:
            0,

        lastMonth2:
            0

    };

    record.closing =
        values[0] || 0;
    record.closingValue =
        values[1] || 0;
    record.sales =
        values[2] || 0;
    record.salesValue =
        values[3] || 0;
    record.lastMonth1 =
        values[4] || 0;
    record.lastMonth2 =
        values[5] || 0;

    return record;

}


//======================================================
// TAB STOCK ROW
//======================================================

function extractTabStockRow(
    line,
    rowNumber
) {

    if (
        !String(line || "").includes("\t")
    ) {
        return null;
    }

    const cells =
        String(line)
            .split("\t")
            .map(value => value.trim());

    if (
        cells.length < 24 ||
        !cells[1] ||
        !cells[2]
    ) {
        return null;
    }

    if (
        /^ITEM\s+CODE$/i.test(cells[1]) ||
        /^ITEM\s+NAME$/i.test(cells[2])
    ) {
        return null;
    }

    const record =
        createRecord(
            rowNumber,
            cells[2],
            cells[3],
            cells[1]
        );

    record.rate =
        toNumber(cells[4]);
    record.opening =
        toNumber(cells[6]);
    record.openingValue =
        toNumber(cells[7]);
    record.purchase =
        toNumber(cells[8]);
    record.purchaseFree =
        toNumber(cells[9]);
    record.replacement =
        toNumber(cells[10]);
    record.purchaseValue =
        toNumber(cells[11]);
    record.purchaseReturn =
        toNumber(cells[12]);
    record.sales =
        toNumber(cells[14]);
    record.free =
        toNumber(cells[15]);
    record.salesValue =
        toNumber(cells[16]);
    record.salesReturn =
        toNumber(cells[19]);
    record.closing =
        toNumber(cells[22]);
    record.closingValue =
        toNumber(cells[23]);

    return record;

}


//======================================================
// SALES / CLOSING / DAY ROW
//======================================================

function extractSalesClosingDayRow(
    line,
    mapping,
    rowNumber
) {

    const headerText =
        String(
            (
                mapping.headers || []
            ).join(" ")
        ).toUpperCase();

    if (
        !headerText.includes("SALES") ||
        !headerText.includes("CLOSING") ||
        !headerText.includes("DAY")
    ) {
        return null;
    }

    const tokens =
        String(line || "")
            .trim()
            .split(/\s+/)
            .filter(Boolean);

    if (tokens.length < 4) {
        return null;
    }

    const trailing = [];

    while (
        tokens.length &&
        /^-?\d+$|^-+$/.test(
            tokens[tokens.length - 1]
        ) &&
        trailing.length < 3
    ) {

        trailing.unshift(
            tokens.pop()
        );

    }

    if (trailing.length < 2) {
        return null;
    }

    const pack =
        tokens.pop() || "";

    const product =
        tokens.join(" ")
            .replace(/^\*/, "")
            .trim();

    if (
        !product ||
        shouldStop(product)
    ) {
        return null;
    }

    const record =
        createRecord(
            rowNumber,
            product,
            pack
        );

    if (trailing.length === 2) {
        record.sales =
            toNumber(trailing[0]);
        record.closing =
            toNumber(trailing[1]);
    }
    else {
        record.sales =
            toNumber(trailing[0]);
        record.closing =
            toNumber(trailing[1]);
        record.age =
            toNumber(trailing[2]);
    }

    return record;

}


//======================================================
// STOCK / AGE ROW
//======================================================

function extractStockAgeRow(
    line,
    mapping,
    rowNumber
) {

    const headerText =
        String(
            (
                mapping.headers || []
            ).join(" ")
        ).toUpperCase();

    if (
        !headerText.includes("QOH") ||
        !headerText.includes("AGE")
    ) {
        return null;
    }

    const numericTokens =
        getNumericTokens(line);

    if (
        numericTokens.length < 7
    ) {
        return null;
    }

    const valueTokens =
        numericTokens.slice(-7);

    const prefix =
        line.substring(
            0,
            valueTokens[0].start
        );

    const productPack =
        splitProductAndPack(prefix);

    if (
        !productPack.product ||
        shouldStop(productPack.product)
    ) {
        return null;
    }

    const values =
        valueTokens.map(
            token =>
                toNumber(token.value)
        );

    return {

        rowNumber,

        product:
            productPack.product,

        productDescription:
            productPack.product,

        productCode:
            null,

        pack:
            productPack.pack,

        opening:
            values[0] || 0,

        purchase:
            values[1] || 0,

        purchaseFree:
            0,

        purchaseReturn:
            0,

        purchaseValue:
            0,

        total:
            values[2] || 0,

        sales:
            values[3] || 0,

        salesReturn:
            0,

        free:
            0,

        replacement:
            0,

        branch:
            0,

        credit:
            0,

        debit:
            0,

        adjustment:
            0,

        salesValue:
            0,

        closing:
            values[4] || 0,

        closingValue:
            values[5] || 0,

        rate:
            0,

        age:
            values[6] || 0

    };

}


//======================================================
// GET POSITION VALUE
//======================================================

function getPositionValue(
    line,
    position,
    endPosition
) {

    if (
        !line ||
        position === null ||
        position === undefined
    ) {

        return "";

    }

    const start =
        Number(position);

    if (
        !Number.isFinite(start)
    ) {

        return "";

    }

    let end;

    if (
        endPosition !== null &&
        endPosition !== undefined
    ) {

        end =
            Number(endPosition);

    }

    else {

        end =
            line.length;

    }

    if (
        !Number.isFinite(end)
    ) {

        end =
            line.length;

    }

    return line
        .substring(
            start,
            end
        )
        .trim();

}


//======================================================
// GET FIXED WIDTH FIELD
//======================================================
//
// Each numeric field ends immediately before the next
// known field.
//
//======================================================

function getField(
    line,
    start,
    nextStart
) {

    if (
        start === null ||
        start === undefined
    ) {

        return "";

    }

    return getPositionValue(
        line,
        start,
        nextStart
    );

}


//======================================================
// GET PRODUCT
//======================================================
//
// Current verified format:
//
// Product = positions 0 â†’ 27
//
//======================================================

function getProduct(
    line,
    position
) {

    const start =
        position === null ||
        position === undefined

            ? 0

            : Number(position);

    return getPositionValue(
        line,
        start,
        27
    );

}


//======================================================
// GET PACKING
//======================================================

function getPacking(
    line,
    position
) {

    return getField(
        line,
        position,
        41
    );

}


//======================================================
// STOP ROW
//======================================================

function shouldStop(
    product
) {

    const text =
        String(
            product || ""
        )
        .trim()
        .toUpperCase();

    if (!text) {

        return true;

    }

    const stopWords = [

        "TOTAL",
        "GRAND TOTAL",
        "SUB TOTAL",
        "SUBTOTAL",
        "SUMMARY",
        "PAGE",
        "PREPARED",
        "PREPARED BY",
        "AUTHORISED",
        "AUTHORIZED",
        "COMPUTER GENERATED",
        "OPENING VALUE",
        "PURCHASE VALUE",
        "SALE VALUE",
        "SALES VALUE",
        "CLOSING VALUE"

    ];

    return stopWords.some(
        word =>

            text === word ||

            text.startsWith(
                word + " "
            ) ||

            text.startsWith(
                word + ":"
            )

    );

}


//======================================================
// SEPARATOR
//======================================================

function isSeparator(
    line
) {

    if (!line) {

        return true;

    }

    return /^[-=_\s]+$/.test(
        String(line)
    );

}


//======================================================
// PRODUCT VALIDATION
//======================================================

function isValidProductRow(
    line,
    product,
    mapping
) {

    if (
        !line ||
        !product
    ) {

        return false;

    }

    //--------------------------------------------------
    // Footer
    //--------------------------------------------------

    if (
        shouldStop(product)
    ) {

        return false;

    }

    //--------------------------------------------------
    // Separator
    //--------------------------------------------------

    if (
        isSeparator(product)
    ) {

        return false;

    }

    //--------------------------------------------------
    // Minimum product length
    //--------------------------------------------------

    if (
        product.length < 2
    ) {

        return false;

    }

    //--------------------------------------------------
    // Check numeric section
    //--------------------------------------------------

    const positions =
        mapping.positions || {};

    const numericStart =
        getMappedPosition(mapping, "opening") !== null &&
        getMappedPosition(mapping, "opening") !== undefined

            ? Number(
                getMappedPosition(mapping, "opening")
            )

            : 0;

    const numericPart =
        line.substring(
            numericStart
        );

    /*
     * Current fixed-width format contains numeric
     * fields after the opening position.
     */

    const numericValues =
        numericPart.match(
            /-?\d+(?:,\d{3})*(?:\.\d+)?/g
        );

    if (
        !numericValues ||
        numericValues.length < 3
    ) {

        return false;

    }

    return true;

}

//======================================================
// CODE NAME STOCK - DATA COLUMN EXTRACTION
//======================================================
//
// Uses physical DATA boundaries when they are available.
// This is intentionally isolated to CODE_NAME_STOCK so
// existing TXT extraction formats are not disturbed.
//
//======================================================

function extractCodeNameStockRow(
    line,
    mapping,
    rowNumber
) {

    if (
        !line ||
        !mapping
    ) {
        return null;
    }

    if (
        mapping.format !==
        "CODE_NAME_STOCK"
    ) {
        return null;
    }


    //--------------------------------------------------
    // CODE_NAME_STOCK
    //
    // IMPORTANT:
    // This format is physically fixed-width.
    //
    // The header mapper creates logical column
    // boundaries, but those boundaries must NOT be
    // used directly for the data row because the
    // product/name area and numeric fields do not
    // have the same boundaries as the header tokens.
    //
    // We therefore use the header positions as anchors
    // and read numeric tokens from the actual data row.
    //--------------------------------------------------


    //--------------------------------------------------
    // TOKENIZE ACTUAL DATA ROW
    //--------------------------------------------------

    const tokens = [];

    const numberRegex =
        /[-+]?\d+(?:\.\d+)?/g;

    let match;

    while (
        (match = numberRegex.exec(line)) !== null
    ) {

        tokens.push({
            text: match[0],
            start: match.index,
            end:
                match.index +
                match[0].length
        });

    }


    //--------------------------------------------------
    // COLUMN ANCHORS
    //--------------------------------------------------

    const columns =
        Array.isArray(mapping.columns)
            ? mapping.columns
            : [];


    function findColumn(
        field,
        source
    ) {

        const matches =
            columns.filter(
                column =>
                    column &&
                    column.field === field
            );


        if (
            !matches.length
        ) {
            return null;
        }


        if (
            source ===
            "GROUP_CHILD"
        ) {

            const child =
                matches.find(
                    column =>
                        column.source ===
                        "GROUP_CHILD"
                );

            if (
                child
            ) {
                return child;
            }

        }


        const direct =
            matches.find(
                column =>
                    column.source ===
                    "DIRECT_HEADER"
            );


        return (
            direct ||
            matches[0]
        );

    }


    //--------------------------------------------------
    // HEADER CENTER
    //--------------------------------------------------

    function columnCenter(
        field,
        source
    ) {

        const column =
            findColumn(
                field,
                source
            );


        if (
            !column
        ) {
            return null;
        }


        if (
            Number.isFinite(
                Number(
                    column.headerCenter
                )
            )
        ) {

            return Number(
                column.headerCenter
            );

        }


        if (
            Number.isFinite(
                Number(
                    column.headerStart
                )
            ) &&
            Number.isFinite(
                Number(
                    column.headerEnd
                )
            )
        ) {

            return (
                Number(
                    column.headerStart
                ) +
                Number(
                    column.headerEnd
                )
            ) / 2;

        }


        return null;

    }


    //--------------------------------------------------
    // GET NUMBER NEAR HEADER POSITION
    //--------------------------------------------------

    function numberNear(
        field,
        source,
        options = {}
    ) {

        const center =
            columnCenter(
                field,
                source
            );


        if (
            center === null
        ) {
            return null;
        }


        const tolerance =
            Number.isFinite(
                Number(
                    options.tolerance
                )
            )
                ? Number(
                    options.tolerance
                )
                : 8;


        let best =
            null;


        let bestDistance =
            Infinity;


        for (
            const token
            of tokens
        ) {

            const tokenCenter =
                (
                    token.start +
                    token.end
                ) / 2;


            const distance =
                Math.abs(
                    tokenCenter -
                    center
                );


            if (
                distance >
                tolerance
            ) {
                continue;
            }


            /*
             * Prefer tokens on or immediately to the
             * right of the header center.
             */

            const rightPenalty =
                tokenCenter < center
                    ? 2
                    : 0;


            const score =
                distance +
                rightPenalty;


            if (
                score <
                bestDistance
            ) {

                best =
                    token;

                bestDistance =
                    score;

            }

        }


        if (
            !best
        ) {
            return null;
        }


        return best.text;

    }


    //--------------------------------------------------
    // GET NUMBER BY ORDER
    //
    // Fallback for cases where the header center is
    // unavailable.
    //--------------------------------------------------

    function numericValue(
        field,
        source,
        fallbackIndex
    ) {

        const near =
            numberNear(
                field,
                source,
                {
                    tolerance: 10
                }
            );


        if (
            near !== null
        ) {
            return toNumber(near);
        }


        if (
            Number.isInteger(
                fallbackIndex
            ) &&
            tokens[fallbackIndex]
        ) {

            return toNumber(
                tokens[fallbackIndex].text
            );

        }


        return 0;

    }


    //--------------------------------------------------
    // PRODUCT
    //--------------------------------------------------

    /*
     * In this format the product occupies everything
     * before the first numeric value.
     *
     * The first numeric value is the rate.
     */

    const rateToken =
        tokens.length
            ? tokens[0]
            : null;


    if (
        !rateToken
    ) {
        return null;
    }


    const product =
        String(
            line.substring(
                0,
                rateToken.start
            )
        ).trim();


    if (
        !product ||
        shouldStop(product)
    ) {
        return null;
    }


    //--------------------------------------------------
    // NUMERIC FIELDS
    //
    // IMPORTANT:
    // The actual data row contains 14 numeric values:
    //
    // 0  rate
    // 1  opening
    // 2  purchase
    // 3  purchaseFree
    // 4  purchaseReturn
    // 5  sales
    // 6  salesFree
    // 7  salesValue
    // 8  salesReturn
    // 9  excess
    // 10 short
    // 11 closing
    // 12 closingFree
    // 13 closingValue
    //
    // Header-center matching is used first.
    // Numeric order is used as a deterministic fallback.
    //--------------------------------------------------

    const rate =
        numericValue(
            "rate",
            undefined,
            0
        );


    const opening =
        numericValue(
            "opening",
            undefined,
            1
        );


    const purchase =
        numericValue(
            "purchase",
            "GROUP_CHILD",
            2
        );


    const purchaseFree =
        numericValue(
            "purchaseFree",
            "GROUP_CHILD",
            3
        );


    const purchaseReturn =
        numericValue(
            "purchaseReturn",
            undefined,
            4
        );


    const sales =
        numericValue(
            "sales",
            "GROUP_CHILD",
            5
        );


    const salesFree =
        numericValue(
            "salesFree",
            "GROUP_CHILD",
            6
        );


    const salesValue =
        numericValue(
            "salesValue",
            undefined,
            7
        );


    const salesReturn =
        numericValue(
            "salesReturn",
            undefined,
            8
        );


    const excess =
        numericValue(
            "excess",
            undefined,
            9
        );


    const short =
        numericValue(
            "short",
            undefined,
            10
        );


    const closing =
        numericValue(
            "closing",
            "GROUP_CHILD",
            11
        );


    const closingFree =
        numericValue(
            "closingFree",
            "GROUP_CHILD",
            12
        );


    const closingValue =
        numericValue(
            "closingValue",
            undefined,
            13
        );


    //--------------------------------------------------
    // PRODUCT CODE
    //--------------------------------------------------

    let productCode = "";


    const productCodeColumn =
        findColumn(
            "productCode"
        );


    if (
        productCodeColumn
    ) {

        const start =
            Number(
                productCodeColumn.headerStart
            );


        const end =
            Number(
                productCodeColumn.headerEnd
            );


        if (
            Number.isFinite(start) &&
            Number.isFinite(end)
        ) {

            productCode =
                String(
                    line.substring(
                        start,
                        Math.min(
                            end + 1,
                            rateToken.start
                        )
                    )
                ).trim();

        }

    }


    //--------------------------------------------------
    // RESULT
    //--------------------------------------------------

    return {

        rowNumber,

        product,

        productDescription:
            product,

        productCode:
            productCode || null,

        pack:
            "",

        opening,

        purchase,

        purchaseFree,

        purchaseReturn,

        purchaseValue:
            0,

        sales,

        salesReturn,

        free:
            0,

        replacement:
            0,

        branch:
            0,

        credit:
            0,

        debit:
            0,

        adjustment:
            0,

        salesValue,

        closing,

        closingValue,

        rate

    };

}
function extractFixedWidthRow(
    line,
    mapping,
    rowNumber
) {

    if (
        !line ||
        !mapping
    ) {

        return null;

    }

    const positions =
        mapping.positions || {};

    const getPosition =
        field => {

            const mapped =
                getMappedPosition(
                    mapping,
                    field
                );

            if (
                mapped !== null &&
                Number.isFinite(mapped)
            ) {
                return mapped;
            }

            return positions[field];

        };

    const requiredPositions = [
        "product",
        "opening",
        "purchase",
        "sales",
        "closing"
    ];

    const hasRequiredPositions =
        requiredPositions.every(
            field => {

                const position =
                    getPosition(field);

                return (
                    position !== null &&
                    position !== undefined &&
                    Number.isFinite(Number(position))
                );

            }
        );

    if (!hasRequiredPositions) {
        return null;
    }

    //--------------------------------------------------
    // PRODUCT
    //--------------------------------------------------

    const product =
        getProduct(
            line,
            getPosition("product")
        );

    //--------------------------------------------------
    // VALIDATE
    //--------------------------------------------------

    if (
        !isValidProductRow(
            line,
            product,
            mapping
        )
    ) {

        return null;

    }

    //--------------------------------------------------
    // PACKING
    //--------------------------------------------------

    const pack =
        getField(
            line,
            getPosition("pack") ??
                getPosition("packing"),
            getPosition("opening")
        );

    //--------------------------------------------------
    // OPENING
    //--------------------------------------------------

    const opening =
        toNumber(
            getField(
                line,
                getPosition("opening"),
                getPosition("purchase")
            )
        );

    //--------------------------------------------------
    // PURCHASE
    //--------------------------------------------------

    const purchase =
        toNumber(
            getField(
                line,
                getPosition("purchase"),
                getPosition("purchaseValue")
            )
        );

    //--------------------------------------------------
    // PURCHASE VALUE
    //--------------------------------------------------

    const purchaseValue =
        toNumber(
            getField(
                line,
                getPosition("purchaseValue"),
                getPosition("sales")
            )
        );

    //--------------------------------------------------
    // SALES
    //--------------------------------------------------

    const sales =
        toNumber(
            getField(
                line,
                getPosition("sales"),
                getPosition("salesValue")
            )
        );

    //--------------------------------------------------
    // SALES VALUE
    //--------------------------------------------------

    const salesValue =
        toNumber(
            getField(
                line,
                getPosition("salesValue"),
                getPosition("closing")
            )
        );

    //--------------------------------------------------
    // CLOSING
    //--------------------------------------------------

    const closing =
        toNumber(
            getField(
                line,
                getPosition("closing"),
                getPosition("closingValue")
            )
        );

    //--------------------------------------------------
    // CLOSING VALUE
    //--------------------------------------------------

    const closingValue =
        toNumber(
            getField(
                line,
                getPosition("closingValue"),
                line.length
            )
        );

    //--------------------------------------------------
    // RESULT
    //--------------------------------------------------

    return {

        rowNumber,

        product,

        productDescription:
            product,

        productCode:
            null,

        pack,

        opening,

        purchase,

        purchaseFree:
            0,

        purchaseReturn:
            0,

        purchaseValue,

        sales,

        salesReturn:
            0,

        free:
            0,

        replacement:
            0,

        branch:
            0,

        credit:
            0,

        debit:
            0,

        adjustment:
            0,

        salesValue,

        closing,

        closingValue,

        rate:
            0

    };

}


//======================================================
// MAIN TXT EXTRACTOR
//======================================================

function extractTXT(
    lines,
    detection,
    mapping
) {

    //--------------------------------------------------
    // SAFETY
    //--------------------------------------------------

    if (
        !Array.isArray(lines)
    ) {

        return {

            success: false,

            totalRecords: 0,

            records: [],

            message:
                "TXT lines must be an array."

        };

    }

    if (
        !mapping
    ) {

        return {

            success: false,

            totalRecords: 0,

            records: [],

            message:
                "TXT mapping is required."

        };

    }

    //--------------------------------------------------
    // DATA START
    //--------------------------------------------------

    let dataStart = 0;

    if (
        detection &&
        (
            detection.dataStartsAt !==
            undefined &&
            detection.dataStartsAt !==
                null
        )
    ) {

        /*
         * Detector reports human-readable line number.
         *
         * Example:
         *
         * Data Starts At: 12
         *
         * Array index:
         *
         * 12 - 1 = 11
         */

        dataStart =
            Number(
                detection.dataStartsAt
            ) - 1;

    }

    else if (
        detection &&
        detection.dataStarts !==
            undefined &&
        detection.dataStarts !==
            null
    ) {

        dataStart =
            Number(
                detection.dataStarts
            ) - 1;

    }

    else if (
        detection &&
        detection.dataStart !==
            undefined &&
        detection.dataStart !==
            null
    ) {

        dataStart =
            Number(
                detection.dataStart
            ) - 1;

    }

    if (
        !Number.isFinite(
            dataStart
        )
    ) {

        dataStart = 0;

    }

    //--------------------------------------------------
    // CLAMP
    //--------------------------------------------------

    dataStart =
        Math.max(
            0,
            Math.min(
                dataStart,
                lines.length
            )
        );

    //--------------------------------------------------
    // RESULT
    //--------------------------------------------------

    const records = [];

    //--------------------------------------------------
    // LOOP
    //--------------------------------------------------

    for (
        let i = dataStart;
        i < lines.length;
        i++
    ) {

        const line =
            String(
                lines[i] || ""
            );

        //------------------------------------------------
        // BLANK
        //------------------------------------------------

        if (
            !line.trim()
        ) {

            continue;

        }

        //------------------------------------------------
        // SEPARATOR
        //------------------------------------------------

        if (
            isSeparator(line)
        ) {

            continue;

        }

        //------------------------------------------------
        // PRODUCT
        //------------------------------------------------

        let product = "";

if (
    mapping.format === "CODE_NAME_STOCK"
) {

    const productColumn =
        Array.isArray(mapping.columns)
            ? mapping.columns.find(
                column =>
                    column &&
                    column.field === "product"
            )
            : null;

    if (productColumn) {

        const start =
            Number(productColumn.dataStart);

        const end =
            Number(productColumn.dataEnd);

        if (
            Number.isFinite(start) &&
            Number.isFinite(end) &&
            end > start
        ) {

            product =
                String(
                    line.substring(
                        start,
                        end
                    )
                ).trim();

        }

    }

}
else {

    product =
        getProduct(
            line,
            getMappedPosition(
                mapping,
                "product"
            )
        );

}

        //------------------------------------------------
        // RECORD
        //------------------------------------------------

        const record =
    extractItemCodeRow(
        line,
        mapping,
        i + 1
    ) ||
    extractStockAgeRow(
        line,
        mapping,
        i + 1
    ) ||
    extractCodeNameStockRow(
        line,
        mapping,
        i + 1
    ) ||
    extractFixedWidthRow(
        line,
        mapping,
        i + 1
    ) ||
    extractSpacedRow(
        line,
        mapping,
        i + 1
    );

        //------------------------------------------------
        // INVALID
        //------------------------------------------------

        if (
            !record
        ) {

            continue;

        }

        //------------------------------------------------
        // PUSH
        //------------------------------------------------

        records.push(
            record
        );

    }

    //--------------------------------------------------
    // DEBUG
    //--------------------------------------------------

    console.log("");

    console.log(
        "========== TXT EXTRACTION =========="
    );

    console.log(
        "Format      :",
        mapping.format || "UNKNOWN"
    );

    console.log(
        "Data Start  :",
        dataStart + 1
    );

    console.log(
        "Records     :",
        records.length
    );

    console.log(
        "===================================="
    );

    //--------------------------------------------------
    // FIRST RECORDS
    //--------------------------------------------------

    if (
        records.length > 0
    ) {

        console.log("");

        console.log(
            "========== FIRST 5 RECORDS =========="
        );

        console.table(
            records.slice(
                0,
                5
            )
        );

        console.log(
            "======================================"
        );

    }

    //--------------------------------------------------
    // RESULT
    //--------------------------------------------------

    return {

        success: true,

        totalRecords:
            records.length,

        records,

        message: ""

    };

}


//======================================================
// EXPORT
//======================================================

module.exports = {

    extractTXT,

    extractFixedWidthRow

};
